{
  "title": "Blendworks asset spec",
  "description": "Rules a delivered 3D asset must meet. Every rule is optional except format; lengths are in metres.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "type": "string",
      "enum": [
        "glb",
        "gltf",
        "fbx",
        "obj",
        "blend"
      ]
    },
    "triangles": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "x": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "y": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "z": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "string",
      "enum": [
        "bottom-centre",
        "centre"
      ]
    },
    "manifold": {
      "type": "boolean"
    },
    "materials": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "uv": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "maxOverlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "fileSize": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "front",
          "back",
          "left",
          "right",
          "top",
          "bottom",
          "three-quarter"
        ]
      }
    },
    "brief": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "format"
  ],
  "additionalProperties": false
}
