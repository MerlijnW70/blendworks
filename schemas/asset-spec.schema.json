{
  "title": "Blendworks asset spec",
  "description": "Rules a delivered 3D asset must meet. Every rule is optional except format; lengths are in metres.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "type": "string",
      "enum": [
        "glb",
        "gltf",
        "fbx",
        "obj",
        "blend"
      ]
    },
    "upAxis": {
      "type": "string",
      "enum": [
        "z",
        "y"
      ]
    },
    "triangles": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minVisible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "x": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "y": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "z": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "minExtent": {
          "type": "number",
          "minimum": 0
        },
        "maxExtent": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "bottom-centre",
            "centre"
          ]
        },
        {
          "type": "object",
          "properties": {
            "point": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "point",
            "tolerance"
          ],
          "additionalProperties": false
        }
      ]
    },
    "manifold": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "noInverted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "faces": {
      "type": "object",
      "properties": {
        "maxDegenerate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxDuplicate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxHiddenRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "shells": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "uv": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "maxOverlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "named": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\x00-\\x1f]+$"
              },
              "required": {
                "type": "boolean"
              },
              "triangles": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "y": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "z": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minExtent": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maxExtent": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "origin": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "bottom-centre",
                      "centre"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "point": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "tolerance": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "point",
                      "tolerance"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "materials": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fileSize": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "selfContained": {
      "type": "boolean"
    },
    "renders": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "front",
          "back",
          "left",
          "right",
          "top",
          "bottom",
          "three-quarter"
        ]
      }
    },
    "brief": {
      "type": "string",
      "maxLength": 4000
    },
    "textures": {
      "type": "object",
      "properties": {
        "required": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseColor",
              "metallicRoughness",
              "normal",
              "emissive",
              "occlusion"
            ]
          }
        },
        "minSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "embedded": {
          "type": "boolean"
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxGpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "powerOfTwo": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "gltf": {
      "type": "object",
      "properties": {
        "validator": {
          "type": "object",
          "properties": {
            "maxErrors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxWarnings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "validator"
      ],
      "additionalProperties": false
    },
    "parts": {
      "type": "object",
      "properties": {
        "maxFloating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "maxFloating"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format"
  ],
  "additionalProperties": false
}
