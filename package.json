{
  "name": "blendworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "blendworks": "src/judge/bin.js"
  },
  "scripts": {
    "build": "tsx scripts/build-native.mjs && tsc -p tsconfig.build.json",
    "build:native": "tsx scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bridge": "tsx scripts/bridge-tests.mjs",
    "rules": "node scripts/rules.mjs",
    "check": "tsx scripts/check.mjs",
    "check:fast": "tsx scripts/check-fast.mjs",
    "check:stress": "tsx scripts/check-stress.mjs",
    "durations": "tsx scripts/durations.mjs",
    "build:addon": "tsx bridge/build-addon.mjs",
    "doctor": "tsx scripts/doctor.mjs",
    "tools:gltfpack": "tsx scripts/tools.mjs",
    "clean": "tsx scripts/clean.mjs",
    "fixtures": "tsx scripts/fixtures.mjs",
    "equivalence": "tsx scripts/judge-equivalence.mjs",
    "judge:image": "tsx scripts/judge-image.mjs",
    "judge:command": "tsx scripts/judge-command.mjs",
    "install-claude": "npm run build && node dist/mcp/install-claude.js",
    "bench:tools": "tsx bench/tool-selection/run.ts",
    "bench:core": "tsx bench/tool-selection/core.ts",
    "bench:terrain": "tsx bench/terrain-kernels/run.ts",
    "calibrate:natural": "tsx scripts/calibrate-natural.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "gltfpack": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
